# Copy to .env.gluetun and fill in your VPN provider's details:
#   cp .env.gluetun.example .env.gluetun
#
# See https://github.com/qdm12/gluetun-wiki for the full list of
# supported providers and their required variables. The example below
# is a common WireGuard setup.

VPN_SERVICE_PROVIDER=your_provider
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=your_private_key
WIREGUARD_ADDRESSES=10.0.0.2/32
SERVER_COUNTRIES=Netherlands

# Firewall: allow inbound connections to the relay's ORPort through the
# tunnel. Required so other Tor relays can reach you.
FIREWALL_INPUT_PORTS=9001
