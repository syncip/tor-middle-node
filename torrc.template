## ============================================================
## Tor middle relay configuration (template)
## Rendered to /etc/tor/torrc by entrypoint.sh via envsubst.
## ============================================================

## --- Identity ---------------------------------------------------
Nickname ${NICKNAME}
ContactInfo ${CONTACT_INFO}

## --- Pure middle relay --------------------------------------------
## No local SOCKS proxy for clients on this host
SocksPort 0

## No exit traffic ever leaves the Tor network through this node
ExitRelay 0
ExitPolicy reject *:*
IPv6Exit 0

## Not a bridge: this relay is publicly listed in the Tor directory
BridgeRelay 0

## Acting as a directory cache is normal for a middle relay. It does
## NOT turn this node into an exit or a bridge.
DirCache ${DIR_CACHE}

## --- Network -------------------------------------------------------
ORPort ${OR_PORT}
${ADDRESS_LINE}

## --- Optional limits ------------------------------------------------
${BANDWIDTH_LINES}
${ACCOUNTING_LINES}
${MYFAMILY_LINE}

## --- Hardening --------------------------------------------------------
Sandbox 1
SafeLogging 1
DisableDebuggerAttachment 1
NoExec 1
AvoidDiskWrites 1
HardwareAccel 0

## --- Logging (stdout, so `docker logs` works) -----------------------
Log notice stdout
RunAsDaemon 0

## --- Data directory ---------------------------------------------------
## Keep this on a persistent volume, otherwise the relay gets a brand new
## identity - and loses all network reputation - on every restart.
DataDirectory /var/lib/tor
User debian-tor
