# Kopieren nach .env und anpassen: cp .env.example .env
# .env NICHT ins Git-Repo committen (siehe .gitignore)!

# --- Identitaet ------------------------------------------------------
NICKNAME=MeinMiddleRelay
CONTACT_INFO=Dein Name <deine-email@example.com>

# --- Netzwerk ----------------------------------------------------------
OR_PORT=9001
# Leer lassen, damit Tor die oeffentliche IP automatisch erkennt.
# Nur setzen, wenn Auto-Erkennung nicht funktioniert (z.B. hinter NAT
# ohne UPnP/manuellem Port-Forwarding).
RELAY_ADDRESS=

# 1 = hilft als Verzeichnis-Cache mit (empfohlen, macht keinen Exit/Bridge daraus)
DIR_CACHE=1

# Mehrere eigene Relays zusammenfassen (Fingerprints kommagetrennt), sonst leer
MYFAMILY=

# --- Bandbreite --------------------------------------------------------
# Tor-internes, SYMMETRISCHES Limit (Sicherheitsnetz, s. torrc.template).
# Format: "<Zahl> <KBytes|MBytes>"
BANDWIDTH_RATE=1 MBytes
BANDWIDTH_BURST=2 MBytes
MAX_ADVERTISED_BANDWIDTH=1 MBytes

# Optionales monatliches/taegliches Datenvolumen-Limit, z.B. "500 GBytes"
ACCOUNTING_MAX=
ACCOUNTING_START=month 1 00:00

# Echtes asymmetrisches Down-/Upload-Limit per tc (braucht NET_ADMIN, s.
# docker-compose.yml). 5 MB/s Down = 40mbit, 1 MB/s Up = 8mbit.
ENABLE_TC_SHAPING=true
IFACE=eth0
DOWNLOAD_LIMIT_MBIT=40
UPLOAD_LIMIT_MBIT=8
