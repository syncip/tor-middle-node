# Copy to .env and adjust: cp .env.example .env
# Do NOT commit your real .env (see .gitignore).
#
# Exit traffic is NOT configurable: this image always runs as a pure
# middle relay (ExitRelay 0, ExitPolicy reject *:*) and refuses to start
# otherwise.

# --- Identity (required) ---------------------------------------------
# 1-19 letters/digits, no spaces
NICKNAME=MyMiddleRelay
CONTACT_INFO=Your Name <your-email@example.com>

# --- Network -----------------------------------------------------------
OR_PORT=9001

# IPv6 for the ORPort: auto (use it if the container has a global IPv6
# address), 1 (always), 0 (IPv4 only)
OR_IPV6=auto

# Leave empty so Tor auto-detects the public IP. Only set this if
# auto-detection fails (e.g. behind NAT, or when using a VPN).
RELAY_ADDRESS=

# Act as a directory cache (recommended; does NOT make this an exit or bridge)
DIR_CACHE=1

# Comma-separated fingerprints of other relays you operate, otherwise empty
MYFAMILY=

# --- Optional bandwidth cap --------------------------------------------
# Leave empty for no cap. Format: "<number> <unit>", e.g. "5 MBytes".
# Tor applies one rate to BOTH directions - no separate up/down limit.
BANDWIDTH_RATE=
BANDWIDTH_BURST=
MAX_ADVERTISED_BANDWIDTH=

# --- Optional data volume cap ------------------------------------------
# e.g. ACCOUNTING_MAX=500 GBytes
ACCOUNTING_MAX=
ACCOUNTING_START=month 1 00:00

# --- Dashboard -----------------------------------------------------------
# Read-only web dashboard. docker-compose.yml publishes it on
# 127.0.0.1:8080 only - use an SSH tunnel to reach it remotely.
DASHBOARD_ENABLED=1
DASHBOARD_PORT=8080
# Optional HTTP basic auth password (any username). Recommended if you
# publish the dashboard on anything other than 127.0.0.1.
DASHBOARD_PASSWORD=

# --- Hardening -------------------------------------------------------------
# Tor's seccomp sandbox. Only set to 0 if Tor fails to start with a
# sandbox error on your platform.
SANDBOX=1
